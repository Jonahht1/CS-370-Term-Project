oy PI=pi@<host>`, with an ownership map by source directory.\n</system-reminder>"}],"session_id":"0bfaa72b-2979-4172-88c1-1c7eb3928112","userType":"external","entrypoint":"cli","cwd":"/home/cole-rechsteiner/projects/CS-370-Term-Project","sessionId":"0bfaa72b-2979-4172-88c1-1c7eb3928112","version":"2.1.284","gitBranch":"test-pi-with-simple-light-circuit"}
